<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
</head>
<body>
  <%- include('./partials/navbar', {path: '/countries'}) %>
  
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1>Country Management</h1>
      <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addCountryModal">
        <i class="fas fa-plus"></i> Add Country
      </button>
    </div>

    <div class="table-responsive">
      <table class="table table-striped table-hover">
        <thead class="table-dark">
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Code</th>
            <th>Users</th>
            <th class="table-actions">Actions</th>
          </tr>
        </thead>
        <tbody id="countries-table-body">
          <tr>
            <td colspan="5" class="text-center">Loading countries...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add Country Modal -->
  <div class="modal fade" id="addCountryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Add New Country</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="addCountryForm">
            <div class="mb-3">
              <label for="name" class="form-label">Name</label>
              <input type="text" class="form-control" id="name" required>
            </div>
            <div class="mb-3">
              <label for="code" class="form-label">Country Code</label>
              <input type="text" class="form-control" id="code" maxlength="3" required>
              <small class="form-text text-muted">2 or 3 letter ISO country code (e.g., US, CA, UK)</small>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-success" id="saveCountry">Save</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit Country Modal -->
  <div class="modal fade" id="editCountryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Edit Country</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="editCountryForm">
            <input type="hidden" id="editCountryId">
            <div class="mb-3">
              <label for="editName" class="form-label">Name</label>
              <input type="text" class="form-control" id="editName" required>
            </div>
            <div class="mb-3">
              <label for="editCode" class="form-label">Country Code</label>
              <input type="text" class="form-control" id="editCode" maxlength="3" required>
              <small class="form-text text-muted">2 or 3 letter ISO country code (e.g., US, CA, UK)</small>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-success" id="updateCountry">Update</button>
        </div>
      </div>
    </div>
  </div>

  <!-- View Country Modal -->
  <div class="modal fade" id="viewCountryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Country Details</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="country-details">
            <p><strong>ID:</strong> <span id="viewCountryId"></span></p>
            <p><strong>Name:</strong> <span id="viewCountryName"></span></p>
            <p><strong>Code:</strong> <span id="viewCountryCode"></span></p>
            <p><strong>Created At:</strong> <span id="viewCountryCreated"></span></p>
            <p><strong>Updated At:</strong> <span id="viewCountryUpdated"></span></p>
          </div>
          <hr>
          <h6>Users from this country:</h6>
          <ul id="viewCountryUsers" class="list-group">
            <li class="list-group-item">Loading users...</li>
          </ul>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div class="modal fade" id="deleteCountryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Confirm Delete</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p>Are you sure you want to delete this country? This action cannot be undone.</p>
          <p><strong>Country:</strong> <span id="deleteCountryName"></span></p>
          <div class="alert alert-warning">
            <strong>Warning:</strong> Deleting this country may affect users associated with it.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-danger" id="confirmDeleteCountry">Delete</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast container for notifications -->
  <div class="position-fixed bottom-0 end-0 p-3" id="toast-container"></div>
  
  <%- include('./partials/footer') %>

  <script>
    // DOM Elements
    const countriesTableBody = document.getElementById('countries-table-body');
    
    // Modals
    const addCountryModal = new bootstrap.Modal(document.getElementById('addCountryModal'));
    const editCountryModal = new bootstrap.Modal(document.getElementById('editCountryModal'));
    const viewCountryModal = new bootstrap.Modal(document.getElementById('viewCountryModal'));
    const deleteCountryModal = new bootstrap.Modal(document.getElementById('deleteCountryModal'));
    
    // Current country ID for edit/delete operations
    let currentCountryId = null;

    // Load countries when page loads
    document.addEventListener('DOMContentLoaded', () => {
      loadCountries();
    });

    // Load all countries
    async function loadCountries() {
      try {
        const response = await api.getCountries();
        const countries = response.data;
        
        if (countries.length === 0) {
          countriesTableBody.innerHTML = '<tr><td colspan="5" class="text-center">No countries found</td></tr>';
          return;
        }
        
        // Get all users to count by country
        const usersResponse = await api.getUsers();
        const users = usersResponse.data;
        
        // Count users by country
        const userCounts = {};
        users.forEach(user => {
          if (user.countryId) {
            userCounts[user.countryId] = (userCounts[user.countryId] || 0) + 1;
          }
        });
        
        countriesTableBody.innerHTML = '';
        countries.forEach(country => {
          const userCount = userCounts[country.id] || 0;
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td>${country.id}</td>
            <td>${country.name}</td>
            <td>${country.code}</td>
            <td>${userCount}</td>
            <td class="table-actions">
              <button class="btn btn-info btn-sm" onclick="viewCountry(${country.id})">
                <i class="fas fa-eye"></i>
              </button>
              <button class="btn btn-warning btn-sm" onclick="editCountry(${country.id})">
                <i class="fas fa-edit"></i>
              </button>
              <button class="btn btn-danger btn-sm" onclick="deleteCountry(${country.id}, '${country.name}')">
                <i class="fas fa-trash"></i>
              </button>
            </td>
          `;
          countriesTableBody.appendChild(tr);
        });
      } catch (error) {
        console.error('Error loading countries:', error);
        showToast('Failed to load countries', 'danger');
        countriesTableBody.innerHTML = '<tr><td colspan="5" class="text-center text-danger">Error loading countries</td></tr>';
      }
    }

    // View country details
    async function viewCountry(id) {
      try {
        const response = await api.getCountry(id);
        const country = response.data;
        
        document.getElementById('viewCountryId').textContent = country.id;
        document.getElementById('viewCountryName').textContent = country.name;
        document.getElementById('viewCountryCode').textContent = country.code;
        document.getElementById('viewCountryCreated').textContent = new Date(country.createdAt).toLocaleString();
        document.getElementById('viewCountryUpdated').textContent = new Date(country.updatedAt).toLocaleString();
        
        // Get users from this country
        const usersResponse = await api.getUsers();
        const countryUsers = usersResponse.data.filter(user => user.countryId === country.id);
        
        const usersList = document.getElementById('viewCountryUsers');
        if (countryUsers.length === 0) {
          usersList.innerHTML = '<li class="list-group-item">No users from this country</li>';
        } else {
          usersList.innerHTML = '';
          countryUsers.forEach(user => {
            const li = document.createElement('li');
            li.className = 'list-group-item';
            li.textContent = `${user.name} (${user.email})`;
            usersList.appendChild(li);
          });
        }
        
        viewCountryModal.show();
      } catch (error) {
        console.error('Error fetching country details:', error);
        showToast('Failed to load country details', 'danger');
      }
    }

    // Prepare edit form with country data
    async function editCountry(id) {
      try {
        const response = await api.getCountry(id);
        const country = response.data;
        
        document.getElementById('editCountryId').value = country.id;
        document.getElementById('editName').value = country.name;
        document.getElementById('editCode').value = country.code;
        
        currentCountryId = country.id;
        editCountryModal.show();
      } catch (error) {
        console.error('Error fetching country for edit:', error);
        showToast('Failed to load country data for editing', 'danger');
      }
    }

    // Prepare delete confirmation
    function deleteCountry(id, name) {
      document.getElementById('deleteCountryName').textContent = name;
      currentCountryId = id;
      deleteCountryModal.show();
    }

    // Save new country
    document.getElementById('saveCountry').addEventListener('click', async () => {
      const nameInput = document.getElementById('name');
      const codeInput = document.getElementById('code');
      
      if (!nameInput.value || !codeInput.value) {
        showToast('Please fill all required fields', 'warning');
        return;
      }
      
      try {
        const countryData = {
          name: nameInput.value,
          code: codeInput.value.toUpperCase()
        };
        
        await api.createCountry(countryData);
        showToast('Country created successfully');
        addCountryModal.hide();
        document.getElementById('addCountryForm').reset();
        loadCountries();
      } catch (error) {
        console.error('Error creating country:', error);
        showToast('Failed to create country', 'danger');
      }
    });

    // Update existing country
    document.getElementById('updateCountry').addEventListener('click', async () => {
      const nameInput = document.getElementById('editName');
      const codeInput = document.getElementById('editCode');
      
      if (!nameInput.value || !codeInput.value) {
        showToast('Please fill all required fields', 'warning');
        return;
      }
      
      try {
        const countryData = {
          name: nameInput.value,
          code: codeInput.value.toUpperCase()
        };
        
        await api.updateCountry(currentCountryId, countryData);
        showToast('Country updated successfully');
        editCountryModal.hide();
        loadCountries();
      } catch (error) {
        console.error('Error updating country:', error);
        showToast('Failed to update country', 'danger');
      }
    });

    // Confirm and delete country
    document.getElementById('confirmDeleteCountry').addEventListener('click', async () => {
      try {
        await api.deleteCountry(currentCountryId);
        showToast('Country deleted successfully');
        deleteCountryModal.hide();
        loadCountries();
      } catch (error) {
        console.error('Error deleting country:', error);
        showToast('Failed to delete country', 'danger');
      }
    });